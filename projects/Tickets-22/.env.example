# Leccion 20 - Docker Compose local
# Copia este archivo a .env si quieres cambiar credenciales o puertos.

# Perfil Spring de Tickets: h2, mysql o supabase.
SPRING_PROFILES_ACTIVE=mysql

# Base de datos usada por Tickets cuando corre dentro o fuera de Compose.
# Para MySQL en Compose usa DB_HOST=mysql y DB_PORT=3306.
# Para PostgreSQL en Compose usa SPRING_PROFILES_ACTIVE=supabase, DB_HOST=postgres y DB_PORT=5432.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tickets_db
DB_USER=tickets
DB_PASSWORD=tickets123

# MySQL container.
MYSQL_DATABASE=tickets_db
MYSQL_USER=tickets
MYSQL_PASSWORD=tickets123
MYSQL_ROOT_PASSWORD=root123

# PostgreSQL container.
POSTGRES_DB=tickets_db
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets123

# URLs internas para comunicacion entre contenedores.
NOTIFICATION_SERVICE_URL=http://notification-service:8081
AUDIT_SERVICE_URL=http://audit-service:8082
SEARCH_SERVICE_URL=http://search-service:8084
SLA_SERVICE_URL=http://sla-service:8085
